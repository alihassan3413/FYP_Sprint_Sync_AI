APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# SQLite only. Production should run WAL so the web, queue and Reverb
# processes stop blocking each other on writes. See deploy/provision.sh.
# DB_JOURNAL_MODE=WAL
# DB_SYNCHRONOUS=NORMAL
# DB_BUSY_TIMEOUT=10000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Still required: powers meeting transcription and assistant voice input.
OPENAI_API_KEY=

# Powers the assistant's replies (ASSISTANT_DRIVER=anthropic).
ANTHROPIC_API_KEY=

TRANSCRIPTION_DRIVER=openai
TRANSCRIPTION_DISK=local
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_MAX_UPLOAD_KB=51200
TRANSCRIPTION_LOW_CONFIDENCE_THRESHOLD=65
ASSISTANT_DRIVER=anthropic
ASSISTANT_DEFAULT_MODEL=claude-sonnet-5
ASSISTANT_ANTHROPIC_EFFORT=medium
ASSISTANT_ANTHROPIC_MAX_TOKENS=4096
ASSISTANT_ANTHROPIC_THINKING=false
# Claude Sonnet 5 costs roughly 20x gpt-4o-mini per token; raise this cap
# accordingly or users will hit it after a handful of exchanges.
ASSISTANT_DAILY_CAP_CENTS=50
ASSISTANT_RATE_PER_MINUTE=10
ASSISTANT_RATE_PER_DAY=200

# Assistant voice input (speech-to-text), via OPENAI_API_KEY.
ASSISTANT_VOICE_MAX_UPLOAD_KB=10240
ASSISTANT_VOICE_RATE_PER_MINUTE=20

# Assistant voice output (text-to-speech), via OPENAI_API_KEY. The browser's
# own speech synthesis is used automatically if this fails or is unset.
# Voices: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer.
ASSISTANT_SPEECH_DRIVER=openai
ASSISTANT_SPEECH_MODEL=gpt-4o-mini-tts
ASSISTANT_SPEECH_VOICE=nova
ASSISTANT_SPEECH_FORMAT=mp3
ASSISTANT_SPEECH_MAX_CHARS=1000

WORKSPACE_INVITATION_TTL_DAYS=7
WORKSPACE_MAX_PER_OWNER=10
