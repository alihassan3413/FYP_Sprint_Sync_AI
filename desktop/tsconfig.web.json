{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "types": [],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "composite": true,
        "noEmit": true
    },
    "include": ["src/renderer/**/*", "src/renderer/**/*.vue", "src/shared/**/*", "src/preload/api.d.ts"]
}
