{
    "name": "sprintsync-desktop",
    "productName": "SprintSync",
    "version": "0.1.0",
    "description": "SprintSync Desktop: a small time tracker for SprintSync",
    "author": "SprintSync",
    "private": true,
    "type": "module",
    "main": "./out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "npm run typecheck && electron-vite build",
        "icons": "electron scripts/generate-icons.mjs",
        "package:dir": "npm run build && electron-builder --dir",
        "package:mac": "npm run build && electron-builder --mac",
        "package:win": "npm run build && electron-builder --win",
        "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
        "lint": "eslint .",
        "test": "vitest run"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "@vitejs/plugin-vue": "^6.0.9",
        "electron": "^44.5.1",
        "electron-builder": "^26.15.3",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.5",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.13.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^7.3.6",
        "vitest": "^5.0.3",
        "vue": "^3.5.43",
        "vue-tsc": "^3.3.12"
    },
    "allowScripts": {
        "esbuild@0.25.12": true,
        "esbuild@0.28.2": true,
        "electron-winstaller": false,
        "fsevents": false
    }
}
